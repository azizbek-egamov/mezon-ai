{
  "name": "@mezon/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MEZON AI admin panel (SuperAdmin / yurist-moderator): Vite + React + Tailwind + @mezon/web-kit",
  "scripts": {
    "dev": "vite",
    "dev:nollm": "vite --mode nollm",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@mezon/api-client": "*",
    "@mezon/i18n": "*",
    "@mezon/web-kit": "*",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.64.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.0",
    "react-router": "^7.18.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
