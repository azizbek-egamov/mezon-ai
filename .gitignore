# ============================================================
# Paketlar va Muhitlar (Dependencies)
# ============================================================
# Python virtual environments
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/

# Python bytecode va keshlar
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Node / Frontend paketlari
node_modules/
**/node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# Ma'lumotlar, Bazalar, Keshlar va Loglar
