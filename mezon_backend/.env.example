# ============================================================
# MEZON AI Backend sozlamalari (.env.example)
# Boshqa kompyuterda ish boshlashda ushbu fayldan nusxa oling:
# cp .env.example .env (yoki Windows da: Copy-Item .env.example .env)
# ============================================================

# Django sozlamalari
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-at-least-50-characters
DJANGO_DEBUG=1

# Baza sozlamalari
# Bo'sh qoldirilsa data/dev.sqlite3 ishlatiladi.
# PostgreSQL uchun:
# DATABASE_URL=postgres://mezon:mezon@localhost:5432/mezon

# Qdrant vektor bazasi
# tools/dev.ps1 start orqali ishga tushiriladi (port :6333)
# Bo'sh qoldirilsa ichki xotira rejimi (RAM ~2.3 GB)
QDRANT_URL=http://127.0.0.1:6333
LEX_REQUEST_DELAY=1.0

# ============================================================
# LLM Provayderi Sozlamalari
# Standart provayder: gemini (Google AI Studio)
# Boshqa variantlar: anthropic | ollama
# ============================================================
LLM_PROVIDER=gemini

# Google AI Studio (Gemini) API kaliti
# https://aistudio.google.com/ dan oling
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini modellar konfiguratsiyasi
LLM_MODEL=gemini-3.1-flash-lite
LLM_MODEL_REWRITE=gemini-3.1-flash-lite
LLM_MODEL_PLAN=gemini-3.1-flash-lite
LLM_MODEL_SELECT=gemini-3.1-flash-lite
LLM_MODEL_EXTRACT=gemini-3.1-flash-lite
LLM_MODEL_ANALYSIS=gemini-3.1-flash-lite
LLM_MODEL_LEGAL=gemini-3.1-flash-lite
LLM_MODEL_LEGAL_RETRY=gemini-3.1-flash-lite
LLM_MODEL_ANSWER=gemini-3.1-flash-lite

# LLM byudjet chegarasi (dollar hisobida, 0 = cheklovsiz)
LLM_BUDGET_USD=5.00

# Muqobil provayder: Anthropic (Claude)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# LLM_MODEL_REWRITE=claude-sonnet-5-5
# LLM_MODEL_PLAN=claude-sonnet-5-5
# LLM_MODEL_SELECT=claude-sonnet-5-5
# LLM_MODEL_EXTRACT=claude-haiku-5-5
# LLM_MODEL_ANALYSIS=claude-sonnet-5-5
# LLM_MODEL_LEGAL=claude-haiku-5-5
# LLM_MODEL_LEGAL_RETRY=claude-sonnet-5-5
# LLM_MODEL_ANSWER=claude-sonnet-5-5

# ============================================================
# Shifrlash (Fernet kalitlari)
# Ish fayllarini (PDF, eksport hisobotlari) shifrlash uchun zarur.
# Yangi kalit hosil qilish buyrug'i:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================
MEZON_DATA_KEYS=your_generated_fernet_key_here

# ============================================================
# Production sozlamalari (Ixtiyoriy)
# ============================================================
# DJANGO_ALLOWED_HOSTS=mezon.uz,app.mezon.uz
# DJANGO_CORS_ORIGINS=https://app.mezon.uz,https://admin.mezon.uz
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.mezon.uz,https://admin.mezon.uz
# DJANGO_SSL_REDIRECT=1
# MEZON_CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP
# MEZON_THREADS=16
# MEZON_BACKUP_DIR=D:/mezon_backups
# MEZON_BACKUP_KEEP=7
